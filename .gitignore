# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key


# Local myPOS credentials (never commit) — dev file and live-store input file
/config/mypos.yml
/config/mypos.production.yml

# Local Speedy credentials (never commit)
/config/speedy.yml

# Local Kamal secrets (never commit)
/.kamal/registry_password
/.kamal/postgres_password

# Local plain-text admin password note (never commit)
/config/admin_password.local

# Local SMTP credentials (never commit)
/config/smtp.yml
