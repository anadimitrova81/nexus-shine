<% content_for :title, "Вход" %>

<div class="admin-login-card">
  <%= image_tag "nexus-shine-logo.png", alt: "Nexus Shine", class: "admin-login-logo" %>
  <h1>Администрация</h1>
  <p>Въведете паролата, за да продължите.</p>
  <%= form_with url: admin_login_path, method: :post, class: "admin-login-form" do %>
    <div class="field">
      <%= label_tag :password, "Парола" %>
      <%= password_field_tag :password, nil, required: true, autofocus: true %>
    </div>
    <%= submit_tag "Вход", class: "btn btn-primary btn-block btn-lg" %>
  <% end %>
  <p class="admin-login-help">Забравена парола? Генерирайте линк за нова парола от сървъра с <code>bin/rails admin:password_reset_link</code>.</p>
</div>
