<!DOCTYPE html>
<html lang="bg">
  <head>
    <title><%= page_title(content_for(:title)) %></title>
    <meta name="description" content="<%= content_for(:description) || "Официален вносител на професионална почистваща химия ERA 111, TURBOPAX и Power 1 за автомивки, перални за килими, дома и индустрията." %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Nexus Shine">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Nexus Shine">
    <meta property="og:locale" content="bg_BG">
    <meta property="og:title" content="<%= content_for(:title) || "Nexus Shine" %>">

    <link rel="icon" href="/icon.png" type="image/png">
    <%= yield :head %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="site-topbar">
      <div class="site-topbar-inner">
        <a href="tel:<%= company[:phone_href] %>" class="site-topbar-phone">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span><%= company[:phone_display] %></span>
        </a>
        <span class="site-topbar-hours">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>Безплатна доставка над 50 €</span>
        </span>
      </div>
    </div>

    <header class="site-header">
      <div class="header-container" data-controller="nav-toggle">
        <%= link_to root_path, class: "site-logo", "aria-label": "Nexus Shine — начало" do %>
          <%= image_tag "nexus-shine-logo.png", alt: "Nexus Shine — Defeat the Dirt!", class: "site-logo-img" %>
        <% end %>
        <button type="button" class="nav-toggle"
                data-nav-toggle-target="button"
                data-action="click->nav-toggle#toggle"
                aria-expanded="false" aria-controls="primary-nav" aria-label="Меню">
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
        </button>
        <nav class="site-nav" id="primary-nav" data-nav-toggle-target="menu" data-open="false">
          <ul>
            <li><%= link_to "Начало", root_path, class: nav_active?(root_path) %></li>
            <li><%= link_to "Продукти", shop_path, class: nav_active?(shop_path) %></li>
            <li><%= link_to "За нас", about_path, class: nav_active?(about_path) %></li>
            <li><%= link_to "Контакти", contact_path, class: nav_active?(contact_path) %></li>
            <li><%= link_to "Въпроси", faq_path, class: nav_active?(faq_path) %></li>
          </ul>
        </nav>
        <%= link_to cart_path, class: "cart-link", "aria-label": "Количка" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          <span class="cart-badge" id="cart-badge" data-count="<%= current_cart.item_count %>"><%= current_cart.item_count %></span>
        <% end %>
      </div>
    </header>

    <main>
      <% if notice.present? %>
        <div class="flash-container">
          <div class="flash flash-notice">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span><%= notice %></span>
          </div>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="flash-container">
          <div class="flash flash-alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span><%= alert %></span>
          </div>
        </div>
      <% end %>
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-col footer-brand">
          <%= image_tag "nexus-shine-logo.png", alt: "Nexus Shine", class: "footer-logo-img" %>
          <p>Официален вносител за България на професионална почистваща химия ERA 111 Professional, TURBOPAX и Power 1.</p>
        </div>
        <div class="footer-col">
          <h4>Магазин</h4>
          <ul>
            <li><%= link_to "Всички продукти", shop_path %></li>
            <li><%= link_to "Автомивки", shop_path(category: "carwash") %></li>
            <li><%= link_to "Пране на килими", shop_path(category: "carpet-washing") %></li>
            <li><%= link_to "Други", shop_path(category: "other") %></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Информация</h4>
          <ul>
            <li><%= link_to "За нас", about_path %></li>
            <li><%= link_to "Въпроси", faq_path %></li>
            <li><%= link_to "Контакти", contact_path %></li>
            <li><%= link_to "Поверителност", privacy_path %></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Контакти</h4>
          <ul class="footer-contact">
            <li><a href="tel:<%= company[:phone_href] %>"><%= company[:phone_display] %></a></li>
            <li><a href="mailto:<%= company[:email] %>"><%= company[:email] %></a></li>
            <li><%= company[:city] %>, <%= company[:postal_code] %></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© <%= Time.current.year %> <%= company[:legal] %>. Всички права запазени.</span>
        <span class="footer-pay">Плащане при доставка · Банков превод · <%= link_to "Админ", admin_root_path %></span>
      </div>
    </footer>

    <%= render "shared/cookie_consent" %>
  </body>
</html>
